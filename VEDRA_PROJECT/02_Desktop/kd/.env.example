# Which kernel implementation the app talks to.
#   mock  = in-memory fixtures (default; no backend required)
#   http  = real Kernel over HTTP + SSE (endpoints are typed placeholders until confirmed)
VITE_KERNEL_ADAPTER=mock

# Base URL of the Kernel. Unused when VITE_KERNEL_ADAPTER=mock.
# NOTE: unverified. Set to whatever C15.0 actually exposes.
VITE_KERNEL_BASE_URL=http://127.0.0.1:8787

# Event stream transport: sse | websocket | poll
VITE_KERNEL_STREAM=sse
