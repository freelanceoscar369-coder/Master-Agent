memory/*
!memory/README.md
logs/*
!logs/README.md
backups/*
!backups/README.md
workspace/*
!workspace/README.md
releases/*
!releases/README.md
config/*
!config/README.md
!config/*.example.*

# Obsidian's own settings folder — created on first open, machine/preference-specific
obsidian/.obsidian/
